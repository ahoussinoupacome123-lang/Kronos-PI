# Réclam'Graph — exemple de configuration. Copier en .env et remplir.
# AUCUN SECRET REEL NE DOIT ETRE COMMITE.

# --- Serveur LLM (OpenAI-compatible : vLLM ou Ollama, interchangeables) ---
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
LLM_API_KEY=not-needed-for-local
LLM_TIMEOUT_S=120
LLM_MAX_CONCURRENCY=16

# --- Modele d'embeddings (bloc 3, GPU) ---
EMBED_MODEL=BAAI/bge-m3

# --- Cle de consortium pour la pseudonymisation HMAC-SHA256 ---
# En production : detenue par un tiers de confiance, jamais dans le depot.
RECLAM_CONSORTIUM_KEY=cle-de-developpement-a-remplacer

# --- Parametres de cout (a remplir depuis leurs sources ; vide => "non calcule") ---
# Prix horaire du GPU utilise, en FCFA/heure
GPU_HOURLY_PRICE_FCFA=
# Tarif API cloud equivalent, en FCFA pour 1000 reclamations
CLOUD_API_PRICE_PER_1K_FCFA=

# --- Regles du radar mules (visibles dans la demo) ---
MULE_MIN_COMPLAINANTS=3
MULE_MIN_OPERATORS=2
MULE_WINDOW_MINUTES=60

# --- Mode demo : rejoue les resultats precalcules, sans LLM ni GPU ---
RECLAM_DEMO_MODE=1
