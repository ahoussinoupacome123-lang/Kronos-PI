# Réclam'Graph — plateforme web. Copier en .env.local (jamais versionné).

# Secret de signature des sessions (32 caractères aléatoires au moins). Obligatoire en production.
AUTH_SECRET=remplacer-par-une-longue-valeur-aleatoire

# Les 4 comptes de démonstration fictifs (src/lib/demo-accounts.ts) partagent le mot de passe
# Demo-Reclam-2026 ; la page de connexion propose aussi une entrée en un clic.

# Compte personnel optionnel (non publié dans le dépôt). Hachage : npm run hash -- "<mot de passe>"
# Attention : dans un fichier .env, échapper les $ du hachage ou l'entourer de guillemets simples si votre outil les interprète.
DEMO_USER_EMAIL=
DEMO_USER_NAME=
DEMO_USER_PASSWORD_HASH=

# Assistant Nexus : serveur LLM compatible OpenAI (le même vLLM que le pipeline : make serve-llm).
# Vide = Nexus répond à partir des résultats mesurés, sans LLM.
LLM_BASE_URL=
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
LLM_API_KEY=
